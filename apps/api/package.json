    "@jimp/js-png": "1.6.1",
    "@jimp/plugin-resize": "1.6.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "hono": "4.13.14",
    "pdfkit": "0.20.2",
    "prisma": "7.10.1",
