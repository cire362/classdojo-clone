// «Герои класса» — схема данных.
// Учётные записи вынесены в Account, чтобы позже добавить родителей и других ролей
// без изменения таблиц учителей и учеников.

// Prisma 7: клиент генерируется в исходники (src/generated, не хранится в git) и работает
// через драйвер pg без двоичного движка запросов. Адрес базы — в prisma.config.ts.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

/// Должность в администрации школы: от неё зависят права в панели школы
enum SchoolRole {
  /// Всё в школе, включая состав администрации и название
  DIRECTOR
  /// Завуч: преподаватели, заявки на подключение, выгрузка файлов групп
  DEPUTY
  /// Сотрудник: только просмотр преподавателей, групп и администрации
  STAFF
}

enum ReasonKind {
  /// Обычная причина, которую преподаватель выбирает вручную
  MANUAL
  /// Системная причина «Посещение» — начисляется автоматически при отметке
  ATTENDANCE
}

model Account {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  admin    Admin?
  teacher  Teacher?
  student  Student?
  parent   Parent?
  sessions Session[]
  messages    Message[]
  feedReads   FeedRead[]
  threadReads ThreadRead[]
  portfolio   PortfolioItem[]
  decisions   RewardRequest[] @relation("DecidedBy")
  awarded  PointEvent[] @relation("AwardedBy")
  postReactions PostReaction[]
  postComments  PostComment[]
  uploadedFiles StoredFile[]
  reports       ContentReport[]
  moderation    ModerationAction[]
  decidedWorks  StudentWork[] @relation("WorkDecidedBy")
  assignments   Assignment[]
}

model Session {
  /// sha256 от токена из cookie — сам токен в БД не хранится
  id        String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
}

/// Администратор управляет преподавателями и видит группы всей установки (одна школа).
/// Школа: её администраторы, преподаватели, их группы и ученики. Данные разных школ не пересекаются.
/// Группа принадлежит школе своего создателя; соавтором может быть только преподаватель той же школы
model School {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  /// Код подключения преподавателей; null — подключение по коду выключено
  joinCode  String?   @unique
  admins    Admin[]
  teachers  Teacher[]
}

model Admin {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  role      SchoolRole @default(DIRECTOR)
  createdAt DateTime   @default(now())
  /// По умолчанию — первая школа установки: её создаёт миграция
  schoolId  String  @default("school-default")
  school    School  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Teacher {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  /// По умолчанию — первая школа установки: так учётки из старых команд и тестов попадают в неё
  schoolId  String   @default("school-default")
  school    School   @relation(fields: [schoolId], references: [id])
  /// Премиум до этой даты (включает администратор: npm run set-premium). Платежей пока нет
  premiumUntil DateTime?
  /// Тихие часы в минутах от полуночи; null — выключены
  quietFrom Int?
  quietTo   Int?
  /// Подключился по коду школы и ждёт проверки администрацией; null — подтверждён. До проверки войти нельзя
  pendingSince DateTime?

  groups   Group[]
  coGroups GroupTeacher[]
  posts    Post[]

  @@index([schoolId])
}

model Group {
  id              String    @id @default(cuid())
  name            String
  teacherId       String
  teacher         Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  /// Вычитать преподавателя из числа людей на фото
  subtractTeacher Boolean   @default(true)
  /// Родители могут комментировать записи ленты
  feedComments    Boolean   @default(true)
  /// Дата переноса в архив; null — группа активна
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())

  students           Student[]
  reasons            BehaviorReason[]
  attendanceSessions AttendanceSession[]
  /// Коллеги, которых владелец (teacherId) добавил в группу
  coTeachers         GroupTeacher[]
  posts              Post[]
  feedReads          FeedRead[]
  rewards            Reward[]
  teams              Team[]
  classGoal          ClassGoal?
  lessonPlan         LessonPlan?
  events             ClassEvent[]
  classCode          ClassCode?
  /// Первенство по уровням учитывается только с момента запуска значков
  badgeTrackingStartedAt DateTime @default(now())
  awardedPoints      PointEvent[] @relation("AwardedInGroup")

  @@index([teacherId])
  files      StoredFile[]
  reports    ContentReport[]
  moderation ModerationAction[]
  assignments Assignment[]
}

/// Соавтор группы: ведёт уроки, отметку, учеников и родителей наравне с владельцем.
/// Удалять, архивировать, переименовывать группу и менять состав преподавателей может только владелец.
model GroupTeacher {
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([groupId, teacherId])
  @@index([teacherId])
}

model Student {
  id              String   @id @default(cuid())
  accountId       String   @unique
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  /// Фото ученика не публикуются, например без согласия родителей. Это напоминание преподавателю:
  /// лиц на снимках система не распознаёт
  noPhotos        Boolean  @default(false)
  /// До какого уровня ученик уже видел поздравление
  celebratedLevel Int      @default(1)
  /// До какого уровня ученик уже видел новые детали в конструкторе
  partsSeenLevel  Int      @default(1)
  /// До какого момента просмотрены решения о выдаче наград
  rewardsReadAt   DateTime @default(now())

  hero        Hero?
  pointEvents PointEvent[]
  attendance  Attendance[]
  parents     ParentStudent[]
  messages    Message[]
  threadReads ThreadRead[]
  portfolio   PortfolioItem[]
  works       StudentWork[]
  assignments AssignmentStudent[]
  rewardRequests RewardRequest[]
  /// Команда на уроке (командный режим); команда принадлежит группе ученика
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  loginCard LoginCard?
  parentInvites ParentInvite[]
  homeGoals  HomeGoal[]
  homePoints HomePoint[]
  files      StoredFile[]

  @@index([groupId])
}

/// Родитель: аккаунт создаёт преподаватель (регистрации нет). Один родитель может быть
/// привязан к нескольким детям — у братьев и сестёр общий вход.
model Parent {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  children    ParentStudent[]
  messages    Message[]
  threadReads ThreadRead[]
}

/// Приглашение родителя: одноразовое, в базе только хеш кода
model ParentInvite {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([studentId])
}

model ParentStudent {
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([parentId, studentId])
  @@index([studentId])
}

/// Домашняя цель: её ставят родители ребёнка. К школьным баллам, уровню и магазину не относится
model HomeGoal {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  target    Int
  createdAt DateTime @default(now())

  points HomePoint[]

  @@index([studentId])
}

/// Домашнее начисление. Причина копируется из цели: история не меняется при её удалении
model HomePoint {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  goalId    String?
  goal      HomeGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  reason    String
  points    Int
  createdAt DateTime  @default(now())

  @@index([studentId, createdAt])
  @@index([goalId])
}

/// Загруженный файл. Хозяин один: группа (видят все её участники) или ученик (видят он, его
/// родители и преподаватели его группы). Это проверяет ограничение CHECK в миграции.
/// Байты лежат в томе, отдельно от базы
model StoredFile {
  id           String   @id @default(cuid())
  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   Account? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  name         String
  mime         String
  size         Int
  createdAt    DateTime @default(now())
  /// Фото записи ленты: удаляются вместе с ней
  postId       String?
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Порядок внутри записи
  position     Int      @default(0)
  /// До этого момента файл видят только преподаватели: так фото отложенной записи не откроются раньше неё
  visibleFrom  DateTime?
  /// Вложение сообщения: видят только участники этой переписки, удаляется вместе с сообщением
  messageId    String?
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Вложение рассылки: одно на все её копии, видят преподаватели группы и получившие её родители
  broadcastId  String?
  /// Файл работы ученика: родители видят его только после одобрения работы
  workId       String?
  work         StudentWork? @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// Файл задания: видят преподаватели группы, получившие задание ученики и их родители
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([messageId])
  @@index([broadcastId])
  @@index([workId])
  @@index([assignmentId])
  @@index([groupId])
  @@index([studentId])
  @@index([uploadedById])
}

/// Очередь очистки диска. Заполняется триггером при любом удалении StoredFile, в том числе каскадном
model DeletedFile {
  id        String   @id
  deletedAt DateTime @default(now())
}

model Hero {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String   @default("")
  /// Выбранные детали: { pose, suit, suitColor, ... } → id детали
  parts     Json
  updatedAt DateTime @updatedAt
}

/// Справочник деталей. Синхронизируется из packages/shared/src/hero/catalog.ts при старте.
model HeroPart {
  id            String  @id
  layer         String
  name          String
  requiredLevel Int
  sortOrder     Int     @default(0)
  /// Задел под платные детали
  isPremium     Boolean @default(false)
  active        Boolean @default(true)
}

model BehaviorReason {
  id        String     @id @default(cuid())
  groupId   String
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  emoji     String
  value     Int
  kind      ReasonKind @default(MANUAL)
  sortOrder Int        @default(0)
  /// Удалённые причины архивируются, чтобы история не теряла названия
  archived  Boolean    @default(false)
  createdAt DateTime   @default(now())

  countsForHelpBadge Boolean @default(false)

  events PointEvent[]

  @@index([groupId])
}

model PointEvent {
  id                  String             @id @default(cuid())
  studentId           String
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reasonId            String?
  reason              BehaviorReason?    @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  /// Снимок названия и эмодзи причины на момент начисления
  reasonName          String
  emoji               String
  value               Int
  createdAt           DateTime           @default(now())
  awardedById         String?
  awardedBy           Account?           @relation("AwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)
  attendanceSessionId String?
  attendanceSession   AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  /// Вклад в цель, действовавшую при начислении (только плюсы)
  classGoalId         String?
  classGoal           ClassGoal? @relation(fields: [classGoalId], references: [id], onDelete: SetNull)
  /// Снимки для значков: переименование причины и перевод ученика не меняют смысл события
  helpBadge           Boolean @default(false)
  awardedGroupId      String?
  awardedGroup        Group? @relation("AwardedInGroup", fields: [awardedGroupId], references: [id], onDelete: SetNull)
  /// Баллы за принятый ответ на задание
  assignmentWork      StudentWork?

  @@index([awardedGroupId, createdAt])
  @@index([studentId, createdAt])
  @@index([classGoalId])
  @@index([attendanceSessionId])
}

model AttendanceSession {
  id                String   @id @default(cuid())
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Календарная дата урока (в часовом поясе приложения)
  date              DateTime @db.Date
  /// Номер урока в этот день (у группы может быть несколько уроков в день)
  lessonNumber      Int      @default(1)
  /// Сколько людей нашлось на фото (null — отметка без фото)
  peopleOnPhoto     Int?
  subtractedTeacher Boolean  @default(false)
  studentsTotal     Int
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// Цель, действовавшая при первой отметке урока; переотметка не переносит вклад в другую цель
  classGoalId       String?
  classGoal         ClassGoal? @relation(fields: [classGoalId], references: [id], onDelete: SetNull)

  records Attendance[]
  points  PointEvent[]

  @@unique([groupId, date, lessonNumber])
  @@index([classGoalId])
}

model Attendance {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present   Boolean

  @@unique([sessionId, studentId])
  @@index([studentId])
}

/// Счётчик неудачных попыток входа (защита от перебора паролей). Общий для всех копий API.
model LoginAttempt {
  /// sha256 от «IP|логин» — сами IP-адреса и логины здесь не хранятся
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Лента класса: объявления преподавателей группы. Видят ученики группы и их родители
model Post {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    Teacher  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  /// Момент публикации: у отложенной записи он в будущем, поэтому лента и счётчики покажут её сами, без планировщика
  createdAt DateTime @default(now())
  pinned    Boolean  @default(false)
  /// Скрыта преподавателем или по жалобам: видят только преподаватели группы
  hiddenAt  DateTime?

  reactions PostReaction[]
  comments  PostComment[]
  reports   ContentReport[]
  reminderFor ClassEvent?
  files     StoredFile[]

  @@index([groupId, createdAt])
}

/// Реакция аккаунта на запись: одна на запись, повторный выбор заменяет
model PostReaction {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String

  @@id([postId, accountId])
}

/// Комментарий родителя или преподавателя; подпись сохраняется при написании
model PostComment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorName String
  text       String
  createdAt  DateTime @default(now())
  hiddenAt   DateTime?
  reports    ContentReport[]

  @@index([postId, createdAt])
}

/// Жалоба родителя на запись ленты или комментарий. Открыта, пока преподаватель её не разобрал
model ContentReport {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  postId     String
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Жалоба на комментарий; без него — на саму запись
  commentId  String?
  comment    PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   Account      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  note       String       @default("")
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([groupId, resolvedAt])
  @@index([postId])
  @@index([commentId])
  @@index([reporterId])
}

/// Журнал модерации группы. Текст сохраняется коротким отрывком: запись или комментарий могли удалить
model ModerationAction {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Кто сделал; пусто — скрыто автоматически по жалобам или аккаунт уже удалён
  actorId   String?
  actor     Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String
  target    String
  targetId  String
  excerpt   String
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
  @@index([actorId])
}

/// До какого момента аккаунт прочитал ленту группы — для счётчика новых записей
model FeedRead {
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  readAt    DateTime

  @@id([accountId, groupId])
}

/// Переписка родителя с преподавателями группы о конкретном ребёнке: ветка = (родитель, ученик)
model Message {
  id          String       @id @default(cuid())
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId    String
  parent      Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  senderId    String
  sender      Account      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text        String
  /// Момент отправки: у отложенного сообщения он в будущем, как у записей ленты
  createdAt   DateTime     @default(now())
  /// Общий для всех копий одной рассылки: по нему находятся её вложения
  broadcastId String?
  files       StoredFile[]

  @@index([studentId, parentId, createdAt])
  @@index([parentId])
  @@index([broadcastId])
}

model ThreadRead {
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  readAt    DateTime

  @@id([accountId, studentId, parentId])
}

/// Портфолио: достижения ученика, которые записывает преподаватель (олимпиада, проект, выступление)
model PortfolioItem {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  emoji       String   @default("🏆")
  createdById String
  createdBy   Account  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([studentId, createdAt])
}

/// Награда в магазине группы: ученик тратит на неё баллы
model Reward {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  emoji     String
  cost      Int
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  requests RewardRequest[]

  @@index([groupId])
}

enum WorkStatus {
  PENDING
  APPROVED
  RETURNED
}

/// Работа ученика: текст и фото или PDF. Без одобрения её видят только сам ученик и преподаватели группы
model StudentWork {
  id          String       @id @default(cuid())
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  text        String       @default("")
  status      WorkStatus   @default(PENDING)
  /// Слова преподавателя: что доделать или похвала
  comment     String       @default("")
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   Account?     @relation("WorkDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Ученик открыл список после решения: решение больше не считается новым
  seenAt      DateTime?
  files       StoredFile[]
  /// Ответ на задание; без него — работа для портфолио
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// Баллы за принятый ответ: снимаются, если ответ вернули на доработку
  pointEventId String?     @unique
  pointEvent   PointEvent? @relation(fields: [pointEventId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([status])
  @@index([assignmentId])
}

/// Задание группе: всему классу, команде или выбранным ученикам. Кому выдано — снимок в AssignmentStudent
model Assignment {
  id          String              @id @default(cuid())
  groupId     String
  group       Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String              @default("")
  /// Сдать до этого дня включительно; позже сдать можно, но с отметкой об опоздании
  dueOn       DateTime?           @db.Date
  /// Баллы за принятый ответ
  points      Int                 @default(0)
  createdById String?
  createdBy   Account?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  students    AssignmentStudent[]
  files       StoredFile[]
  works       StudentWork[]

  @@index([groupId, createdAt])
}

model AssignmentStudent {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Ученик видел задание: оно больше не считается новым
  seenAt       DateTime?

  @@id([assignmentId, studentId])
  @@index([studentId])
}

enum RewardStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Запрос награды. Баллы списываются сразу (PENDING тоже занимает баланс), при отказе возвращаются
model RewardRequest {
  id          String       @id @default(cuid())
  rewardId    String
  reward      Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Снимок награды на момент запроса: цену и название могут поменять позже
  title       String
  emoji       String
  cost        Int
  status      RewardStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   Account?     @relation("DecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([studentId, status, decidedAt])
}

/// Команда для командного режима на уроке
model Team {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  students Student[]

  @@index([groupId])
}

/// Одна общая текущая цель класса; новая цель начинается с нуля.
/// Событие календаря группы. Дата и время хранятся как есть: это время школы, а не момент на шкале
model ClassEvent {
  id             String   @id @default(cuid())
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title          String
  description    String   @default("")
  date           DateTime @db.Date
  /// «ЧЧ:ММ»; null — событие на весь день
  time           String?
  /// За сколько дней напомнить; null — без напоминания
  remindDays     Int?
  /// Напоминание — отложенная запись ленты: придёт само вместе со значками и уведомлениями
  reminderPostId String?  @unique
  reminderPost   Post?    @relation(fields: [reminderPostId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([groupId, date])
}

/// Общий код класса: короткий и живёт недолго, поэтому хранится открыто и показывается преподавателю повторно
model ClassCode {
  groupId   String   @id
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// QR-карточка ученика: в базе только хеш токена, поэтому карточку можно выпустить, но не показать повторно
model LoginCard {
  studentId String   @id
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// План урока группы: шаги по порядку и текущий шаг на экране
model LessonPlan {
  groupId   String   @id
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Тексты шагов по порядку
  steps     Json
  /// Номер текущего шага в steps, с нуля
  current   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ClassGoal {
  id          String   @id @default(cuid())
  groupId     String   @unique
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  target      Int
  createdAt   DateTime @default(now())
  points      PointEvent[]
  sessions    AttendanceSession[]
}
