// «Герои класса» — схема данных.
// Учётные записи вынесены в Account, чтобы позже добавить родителей и других ролей
// без изменения таблиц учителей и учеников.

// Prisma 7: клиент генерируется в исходники (src/generated, не хранится в git) и работает
// через драйвер pg без двоичного движка запросов. Адрес базы — в prisma.config.ts.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum ReasonKind {
  /// Обычная причина, которую преподаватель выбирает вручную
  MANUAL
  /// Системная причина «Посещение» — начисляется автоматически при отметке
  ATTENDANCE
}

model Account {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  admin    Admin?
  teacher  Teacher?
  student  Student?
  parent   Parent?
  sessions Session[]
  messages    Message[]
  feedReads   FeedRead[]
  threadReads ThreadRead[]
  portfolio   PortfolioItem[]
  decisions   RewardRequest[] @relation("DecidedBy")
  awarded  PointEvent[] @relation("AwardedBy")
}

model Session {
  /// sha256 от токена из cookie — сам токен в БД не хранится
  id        String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
}

/// Администратор управляет преподавателями и видит группы всей установки (одна школа).
model Admin {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
}

model Teacher {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  /// Премиум до этой даты (включает администратор: npm run set-premium). Платежей пока нет
  premiumUntil DateTime?

  groups   Group[]
  coGroups GroupTeacher[]
  posts    Post[]
}

model Group {
  id              String    @id @default(cuid())
  name            String
  teacherId       String
  teacher         Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  /// Вычитать преподавателя из числа людей на фото
  subtractTeacher Boolean   @default(true)
  /// Дата переноса в архив; null — группа активна
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())

  students           Student[]
  reasons            BehaviorReason[]
  attendanceSessions AttendanceSession[]
  /// Коллеги, которых владелец (teacherId) добавил в группу
  coTeachers         GroupTeacher[]
  posts              Post[]
  feedReads          FeedRead[]
  rewards            Reward[]
  teams              Team[]
  classGoal          ClassGoal?
  lessonPlan         LessonPlan?
  classCode          ClassCode?
  /// Первенство по уровням учитывается только с момента запуска значков
  badgeTrackingStartedAt DateTime @default(now())
  awardedPoints      PointEvent[] @relation("AwardedInGroup")

  @@index([teacherId])
}

/// Соавтор группы: ведёт уроки, отметку, учеников и родителей наравне с владельцем.
/// Удалять, архивировать, переименовывать группу и менять состав преподавателей может только владелец.
model GroupTeacher {
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([groupId, teacherId])
  @@index([teacherId])
}

model Student {
  id              String   @id @default(cuid())
  accountId       String   @unique
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  /// До какого уровня ученик уже видел поздравление
  celebratedLevel Int      @default(1)
  /// До какого уровня ученик уже видел новые детали в конструкторе
  partsSeenLevel  Int      @default(1)
  /// До какого момента просмотрены решения о выдаче наград
  rewardsReadAt   DateTime @default(now())

  hero        Hero?
  pointEvents PointEvent[]
  attendance  Attendance[]
  parents     ParentStudent[]
  messages    Message[]
  threadReads ThreadRead[]
  portfolio   PortfolioItem[]
  rewardRequests RewardRequest[]
  /// Команда на уроке (командный режим); команда принадлежит группе ученика
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  loginCard LoginCard?

  @@index([groupId])
}

/// Родитель: аккаунт создаёт преподаватель (регистрации нет). Один родитель может быть
/// привязан к нескольким детям — у братьев и сестёр общий вход.
model Parent {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  children    ParentStudent[]
  messages    Message[]
  threadReads ThreadRead[]
}

model ParentStudent {
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([parentId, studentId])
  @@index([studentId])
}

model Hero {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String   @default("")
  /// Выбранные детали: { pose, suit, suitColor, ... } → id детали
  parts     Json
  updatedAt DateTime @updatedAt
}

/// Справочник деталей. Синхронизируется из packages/shared/src/hero/catalog.ts при старте.
model HeroPart {
  id            String  @id
  layer         String
  name          String
  requiredLevel Int
  sortOrder     Int     @default(0)
  /// Задел под платные детали
  isPremium     Boolean @default(false)
  active        Boolean @default(true)
}

model BehaviorReason {
  id        String     @id @default(cuid())
  groupId   String
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  emoji     String
  value     Int
  kind      ReasonKind @default(MANUAL)
  sortOrder Int        @default(0)
  /// Удалённые причины архивируются, чтобы история не теряла названия
  archived  Boolean    @default(false)
  createdAt DateTime   @default(now())

  countsForHelpBadge Boolean @default(false)

  events PointEvent[]

  @@index([groupId])
}

model PointEvent {
  id                  String             @id @default(cuid())
  studentId           String
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reasonId            String?
  reason              BehaviorReason?    @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  /// Снимок названия и эмодзи причины на момент начисления
  reasonName          String
  emoji               String
  value               Int
  createdAt           DateTime           @default(now())
  awardedById         String?
  awardedBy           Account?           @relation("AwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)
  attendanceSessionId String?
  attendanceSession   AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  /// Вклад в цель, действовавшую при начислении (только плюсы)
  classGoalId         String?
  classGoal           ClassGoal? @relation(fields: [classGoalId], references: [id], onDelete: SetNull)
  /// Снимки для значков: переименование причины и перевод ученика не меняют смысл события
  helpBadge           Boolean @default(false)
  awardedGroupId      String?
  awardedGroup        Group? @relation("AwardedInGroup", fields: [awardedGroupId], references: [id], onDelete: SetNull)

  @@index([awardedGroupId, createdAt])
  @@index([studentId, createdAt])
  @@index([classGoalId])
  @@index([attendanceSessionId])
}

model AttendanceSession {
  id                String   @id @default(cuid())
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Календарная дата урока (в часовом поясе приложения)
  date              DateTime @db.Date
  /// Номер урока в этот день (у группы может быть несколько уроков в день)
  lessonNumber      Int      @default(1)
  /// Сколько людей нашлось на фото (null — отметка без фото)
  peopleOnPhoto     Int?
  subtractedTeacher Boolean  @default(false)
  studentsTotal     Int
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// Цель, действовавшая при первой отметке урока; переотметка не переносит вклад в другую цель
  classGoalId       String?
  classGoal         ClassGoal? @relation(fields: [classGoalId], references: [id], onDelete: SetNull)

  records Attendance[]
  points  PointEvent[]

  @@unique([groupId, date, lessonNumber])
  @@index([classGoalId])
}

model Attendance {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present   Boolean

  @@unique([sessionId, studentId])
  @@index([studentId])
}

/// Счётчик неудачных попыток входа (защита от перебора паролей). Общий для всех копий API.
model LoginAttempt {
  /// sha256 от «IP|логин» — сами IP-адреса и логины здесь не хранятся
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Лента класса: объявления преподавателей группы. Видят ученики группы и их родители
model Post {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    Teacher  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

/// До какого момента аккаунт прочитал ленту группы — для счётчика новых записей
model FeedRead {
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  readAt    DateTime

  @@id([accountId, groupId])
}

/// Переписка родителя с преподавателями группы о конкретном ребёнке: ветка = (родитель, ученик)
model Message {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  senderId  String
  sender    Account  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([studentId, parentId, createdAt])
  @@index([parentId])
}

model ThreadRead {
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  readAt    DateTime

  @@id([accountId, studentId, parentId])
}

/// Портфолио: достижения ученика, которые записывает преподаватель (олимпиада, проект, выступление)
model PortfolioItem {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  emoji       String   @default("🏆")
  createdById String
  createdBy   Account  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([studentId, createdAt])
}

/// Награда в магазине группы: ученик тратит на неё баллы
model Reward {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  emoji     String
  cost      Int
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  requests RewardRequest[]

  @@index([groupId])
}

enum RewardStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Запрос награды. Баллы списываются сразу (PENDING тоже занимает баланс), при отказе возвращаются
model RewardRequest {
  id          String       @id @default(cuid())
  rewardId    String
  reward      Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Снимок награды на момент запроса: цену и название могут поменять позже
  title       String
  emoji       String
  cost        Int
  status      RewardStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   Account?     @relation("DecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([studentId, status, decidedAt])
}

/// Команда для командного режима на уроке
model Team {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  students Student[]

  @@index([groupId])
}

/// Одна общая текущая цель класса; новая цель начинается с нуля.
/// Общий код класса: короткий и живёт недолго, поэтому хранится открыто и показывается преподавателю повторно
model ClassCode {
  groupId   String   @id
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// QR-карточка ученика: в базе только хеш токена, поэтому карточку можно выпустить, но не показать повторно
model LoginCard {
  studentId String   @id
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// План урока группы: шаги по порядку и текущий шаг на экране
model LessonPlan {
  groupId   String   @id
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Тексты шагов по порядку
  steps     Json
  /// Номер текущего шага в steps, с нуля
  current   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ClassGoal {
  id          String   @id @default(cuid())
  groupId     String   @unique
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  target      Int
  createdAt   DateTime @default(now())
  points      PointEvent[]
  sessions    AttendanceSession[]
}
